<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Trading Lab</title>
  <style>
    :root {
      --bg: #080808;
      --panel: #121212;
      --gold: #d4af37;
      --text: #f5f5f5;
      --muted: #929292;
      --green: #35d07f;
      --red: #ff6262;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: Arial, sans-serif;
      padding: 18px;
    }
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 24px;
    }
    .logo {
      color: var(--gold);
      font-size: 20px;
      font-weight: bold;
    }
    .badge {
      color: var(--green);
      font-size: 12px;
      border: 1px solid #245a3e;
      padding: 7px 10px;
      border-radius: 20px;
    }
    h1 {
      font-size: 25px;
      margin-bottom: 10px;
    }
    .subtitle {
      color: var(--muted);
      line-height: 1.7;
      font-size: 14px;
      margin-bottom: 24px;
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 20px;
    }
    .card {
      background: var(--panel);
      border: 1px solid #282828;
      border-radius: 14px;
      padding: 16px;
    }
    .label {
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 12px;
    }
    .value {
      font-size: 23px;
      font-weight: bold;
    }
    .gold {
      color: var(--gold);
    }
    .section {
      background: var(--panel);
      border: 1px solid #282828;
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 18px;
    }
    h2 {
      font-size: 17px;
      margin-bottom: 16px;
    }
    select, button {
      width: 100%;
      padding: 13px;
      border-radius: 9px;
      font-size: 15px;
      margin-bottom: 12px;
    }
    select {
      background: #1d1d1d;
      color: white;
      border: 1px solid #393939;
    }
    button {
      background: var(--gold);
      color: #080808;
      border: none;
      font-weight: bold;
      cursor: pointer;
    }
    button:active {
      opacity: 0.8;
    }
    .secondary {
      background: #242424;
      color: var(--gold);
      border: 1px solid #454545;
    }
    .status {
      background: #1c1c1c;
      padding: 14px;
      border-radius: 9px;
      line-height: 1.8;
      font-size: 13px;
      color: var(--muted);
      overflow-wrap: anywhere;
    }
    .status strong {
      color: var(--gold);
    }
    .market-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 14px 0;
      border-bottom: 1px solid #292929;
      font-size: 14px;
    }
    .market-row:last-child {
      border-bottom: none;
    }
    .up {
      color: var(--green);
    }
    .down {
      color: var(--red);
    }
    .notice {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.8;
      margin-top: 12px;
    }
    footer {
      color: #777;
      text-align: center;
      font-size: 12px;
      padding: 15px 0;
    }
    @media (max-width: 360px) {
      body {
        padding: 12px;
      }
      .value {
        font-size: 19px;
      }
      .logo {
        font-size: 17px;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="logo">◆ AI TRADING LAB</div>
    <div class="badge">● DEMO MODE</div>
  </header>
  <main>
    <h1>مختبر التداول الذكي</h1>
    <p class="subtitle">
      مساحة شخصية لتحليل الأسواق وتجربة الاستراتيجيات
      ومتابعة نتائج التداول الافتراضي.
    </p>
    <div class="grid">
      <div class="card">
        <div class="label">الرصيد الافتراضي</div>
        <div class="value gold" id="balance">$10.00</div>
      </div>
      <div class="card">
        <div class="label">صافي الربح التجريبي</div>
        <div class="value" id="profit">$0.00</div>
      </div>
      <div class="card">
        <div class="label">الصفقات التجريبية</div>
        <div class="value" id="tradeCount">0</div>
      </div>
      <div class="card">
        <div class="label">حالة المختبر</div>
        <div class="value gold" style="font-size:17px" id="labStatus">
          جاهز
        </div>
      </div>
    </div>
    <section class="section">
      <h2>اختيار السوق</h2>
      <select id="market">
        <option value="XAUUSD">الذهب — XAU/USD</option>
        <option value="EURUSD">اليورو / الدولار — EUR/USD</option>
        <option value="GBPUSD">الجنيه الإسترليني / الدولار — GBP/USD</option>
        <option value="USDJPY">الدولار / الين — USD/JPY</option>
        <option value="OIL">النفط — OIL</option>
      </select>
      <select id="duration">
        <option value="1">مدة التجربة: دقيقة واحدة</option>
        <option value="5">مدة التجربة: 5 دقائق</option>
        <option value="15">مدة التجربة: 15 دقيقة</option>
        <option value="60">مدة التجربة: ساعة</option>
        <option value="180">مدة التجربة: 3 ساعات</option>
        <option value="1440">مدة التجربة: 24 ساعة</option>
      </select>
      <button onclick="analyzeMarket()">تحليل تجريبي للسوق</button>
      <div class="status" id="analysis">
        <strong>نتيجة التحليل:</strong><br>
        اختر السوق واضغط على زر التحليل لعرض النتيجة.
      </div>
      <p class="notice">
        ملاحظة: التحليل الحالي تجريبي وتوضيحي، ولا يستخدم بيانات
        سوق مباشرة أو ذكاءً اصطناعيًا متصلًا بمصدر خارجي.
      </p>
    </section>
    <section class="section">
      <h2>لوحة محاكاة الصفقات</h2>
      <select id="direction">
        <option value="buy">شراء — BUY</option>
        <option value="sell">بيع — SELL</option>
      </select>
      <button onclick="openTrade()">تنفيذ صفقة افتراضية</button>
      <button class="secondary" onclick="resetLab()">إعادة ضبط المختبر</button>
      <div class="status" id="tradeResult">
        لا توجد صفقات حتى الآن.
      </div>
      <p class="notice">
        المحاكاة تستخدم تغيرات سعرية عشوائية للتجربة فقط.
        النتائج ليست توقعات حقيقية لحركة السوق.
      </p>
    </section>
    <section class="section">
      <h2>الأسواق المتاحة</h2>
      <div class="market-row">
        <span>الذهب</span>
        <span class="gold">XAU/USD</span>
      </div>
      <div class="market-row">
        <span>اليورو / الدولار</span>
        <span>EUR/USD</span>
      </div>
      <div class="market-row">
        <span>الإسترليني / الدولار</span>
        <span>GBP/USD</span>
      </div>
      <div class="market-row">
        <span>الدولار / الين</span>
        <span>USD/JPY</span>
      </div>
      <div class="market-row">
        <span>النفط</span>
        <span>OIL</span>
      </div>
    </section>
  </main>
  <footer>
    AI Trading Lab © 2026 — Personal Demo Project
  </footer>
  <script>
    let balance = 10;
    let profit = 0;
    let tradeCount = 0;
    function analyzeMarket() {
      const market = document.getElementById("market");
      const duration = document.getElementById("duration").value;
      const name = market.options[market.selectedIndex].text;
      document.getElementById("labStatus").textContent = "تم التحليل";
      document.getElementById("analysis").innerHTML =
        "<strong>السوق:</strong> " + name + "<br>" +
        "<strong>مدة التجربة:</strong> " + duration + " دقيقة<br>" +
        "<strong>حالة النظام:</strong> يعمل بنجاح<br>" +
        "<strong>النتيجة:</strong> واجهة التحليل جاهزة للاختبار.<br>" +
        "لا توجد بيانات حقيقية كافية لإصدار إشارة تداول موثوقة.";
    }
    function openTrade() {
      const direction = document.getElementById("direction").value;
      const market = document.getElementById("market");
      const name = market.options[market.selectedIndex].text;
      if (balance <= 0) {
        document.getElementById("tradeResult").textContent =
          "الرصيد الافتراضي انتهى. أعد ضبط المختبر لبدء تجربة جديدة.";
        return;
      }
      const stake = Math.min(1, balance);
      const change = (Math.random() * 2 - 1) * stake;
      balance += change;
      profit += change;
      tradeCount++;
      document.getElementById("balance").textContent =
        "$" + balance.toFixed(2);
      document.getElementById("profit").textContent =
        (profit >= 0 ? "$" : "-$") + Math.abs(profit).toFixed(2);
      document.getElementById("tradeCount").textContent = tradeCount;
      document.getElementById("tradeResult").innerHTML =
        "<strong>الصفقة التجريبية رقم:</strong> " + tradeCount + "<br>" +
        "<strong>السوق:</strong> " + name + "<br>" +
        "<strong>العملية:</strong> " +
        (direction === "buy" ? "شراء BUY" : "بيع SELL") + "<br>" +
        "<strong>التغير العشوائي:</strong> " +
        (change >= 0 ? "+" : "-") + "$" + Math.abs(change).toFixed(2) +
        "<br><strong>الرصيد الحالي:</strong> $" + balance.toFixed(2) +
        "<br>هذه نتيجة عشوائية للمحاكاة وليست نتيجة صفقة سوق حقيقية.";
    }
    function resetLab() {
      balance = 10;
      profit = 0;
      tradeCount = 0;
      document.getElementById("balance").textContent = "$10.00";
      document.getElementById("profit").textContent = "$0.00";
      document.getElementById("tradeCount").textContent = "0";
      document.getElementById("labStatus").textContent = "جاهز";
      document.getElementById("tradeResult").textContent =
        "تمت إعادة ضبط المختبر. الرصيد الافتراضي $10.00.";
    }
  </script>
</body>
</html>
