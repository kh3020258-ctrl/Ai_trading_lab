<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Trading Lab</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#08090c;color:#f5f5f5;font-family:Arial,sans-serif;padding:18px}
header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #292929;padding-bottom:18px}
.logo{font-size:21px;font-weight:bold;color:#e7bd62}
.logo span{color:white}
.badge{color:#e7bd62;border:1px solid #8d7037;padding:7px 10px;border-radius:20px;font-size:11px}
h1{font-size:26px;margin-top:28px}
.gold{color:#e7bd62}
.subtitle{color:#92949d;font-size:13px;line-height:1.6}
.card{background:#111319;border:1px solid #292b31;border-radius:14px;padding:17px;margin-top:17px}
.label{color:#999da8;font-size:12px}
.balance{font-size:30px;font-weight:bold;margin-top:9px}
.positive{color:#40d6a0;font-size:13px;margin-top:8px}
.section-title{font-size:17px;font-weight:bold;margin:27px 0 12px}
.markets{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.market{background:#111319;border:1px solid #303139;border-radius:12px;padding:14px;cursor:pointer;color:white;text-align:left}
.market.active{border-color:#e7bd62;background:#211d13}
.market strong{display:block;margin-bottom:8px;font-size:14px}
.market small{color:#aaa}
.price{font-size:18px;font-weight:bold;margin-top:7px}
select,button{width:100%;padding:13px;background:#17191f;border:1px solid #383a42;border-radius:9px;color:white;font-size:14px;margin-top:10px}
button.primary{background:#e7bd62;color:#111;font-weight:bold;border:0}
button:active{opacity:.8}
.status{display:inline-block;color:#40d6a0;font-size:12px}
footer{text-align:center;color:#777;font-size:11px;padding:25px 0}
</style>
</head>
<body>
<header>
<div class="logo">AI <span>TRADING LAB</span></div>
<div class="badge">PAPER MODE</div>
</header>

<h1>Your Personal<br><span class="gold">Trading Terminal</span></h1>
<p class="subtitle">AI-assisted market analysis & strategy testing.<br>Simulation only — no real trades.</p>

<div class="card">
<div class="label">VIRTUAL ACCOUNT BALANCE</div>
<div class="balance" id="balance">$10.00</div>
<div class="positive">● Demo account active</div>
</div>

<div class="section-title">Market Watch <span class="gold">/ Assets</span></div>
<div class="markets">
<button class="market active" onclick="choose(this,'Gold','XAU/USD')">
<strong>🥇 GOLD</strong><small>XAU/USD</small><div class="price">Selected</div>
</button>
<button class="market" onclick="choose(this,'EUR/USD','EUR/USD')">
<strong>💱 EUR/USD</strong><small>Forex</small><div class="price">Selected</div>
</button>
<button class="market" onclick="choose(this,'Oil','WTI')">
<strong>🛢️ CRUDE OIL</strong><small>WTI</small><div class="price">Selected</div>
</button>
<button class="market" onclick="choose(this,'GBP/USD','GBP/USD')">
<strong>💱 GBP/USD</strong><small>Forex</small><div class="price">Selected</div>
</button>
</div>

<div class="section-title">AI Analysis <span class="gold">/ Lab</span></div>
<div class="card">
<div class="label">SELECTED ASSET</div>
<div class="price" id="asset">Gold — XAU/USD</div>
<label class="label" for="duration">Analysis duration</label>
<select id="duration">
<option>1 minute</option><option>5 minutes</option>
<option>15 minutes</option><option>1 hour</option>
<option>4 hours</option><option>12 hours</option>
<option>24 hours</option>
</select>
<button class="primary" onclick="analyze()">Run Demo Analysis</button>
<p id="analysis" class="subtitle">Ready to test a strategy using demo data.</p>
</div>

<div class="section-title">Paper Trading <span class="gold">/ Simulation</span></div>
<div class="card">
<div class="label">SIMULATION DURATION</div>
<select id="tradeDuration">
<option>1 hour</option><option>2 hours</option>
<option>3 hours</option><option>6 hours</option>
<option>12 hours</option><option>24 hours</option>
</select>
<div class="label" style="margin-top:18px">SIMULATED DIRECTION</div>
<select id="direction">
<option>Buy</option><option>Sell</option>
</select>
<button class="primary" onclick="trade()">Record Demo Trade</button>
<p id="tradeMessage" class="subtitle">No simulated trades recorded yet.</p>
</div>

<div class="section-title">System Status</div>
<div class="card">
<p><span class="status">●</span> Interface ready</p>
<p class="subtitle">Market prices are not connected yet. Analysis is a demo placeholder, not a live AI signal.</p>
</div>

<footer>AI TRADING LAB · PRIVATE WORKSPACE · SIMULATION ONLY</footer>

<script>
let selectedAsset="Gold — XAU/USD";
function choose(button,name,symbol){
document.querySelectorAll('.market').forEach(b=>b.classList.remove('active'));
button.classList.add('active');
selectedAsset=name+" — "+symbol;
document.getElementById('asset').textContent=selectedAsset;
}
function analyze(){
let duration=document.getElementById('duration').value;
document.getElementById('analysis').textContent=
"Demo analysis requested for "+selectedAsset+" over "+duration+". Connect a market data source and real analysis engine before using actual signals.";
}
function trade(){
let direction=document.getElementById('direction').value;
let duration=document.getElementById('tradeDuration').value;
document.getElementById('tradeMessage').textContent=
"Demo trade recorded: "+direction+" "+selectedAsset+" · Duration: "+duration+". No real order was placed.";
}
</script>
</body>
</html>
